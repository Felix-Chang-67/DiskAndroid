 uint32_t debug_mask = (uint32_t)-1; /* set all bits to make sure bd_debug() is called for initialization */
 
+void (*aacs_log_hook)(int level, const char *msg) = NULL;
+
+/*
+ * DiskAndroid: keys, certificates and command payloads are printed as long
+ * hex strings. They must not end up in the application's log: replace every
+ * run of 16 or more hex digits with "<...>". The disc ID is kept (it is what
+ * KEYDB.cfg entries are looked up by).
+ */
+static void _redact_keys(char *s)
+{
+    char *out = s;
+    const char *p = s;
+
+    while (*p) {
+        size_t n = strspn(p, "0123456789abcdefABCDEF");
+        if (n >= 16) {
+            memcpy(out, "<...>", 5);
+            out += 5;
+            p += n;
+        } else if (n > 0) {
+            memmove(out, p, n);
+            out += n;
+            p += n;
+        } else {
+            *out++ = *p++;
+        }
+    }
+    *out = 0;
+}
