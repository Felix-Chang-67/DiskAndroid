+++ b/src/host.h	2026-11-11 03:50:17.052666206 +0000
@@ -0,0 +1,30 @@
+/*****************************************************************************
+ * host.h: SCSI pass-through supplied by the host application (DiskAndroid)
+ *****************************************************************************
+ * In stream mode libdvdcss has no device to send ioctls to. When the host
+ * application registers a dc_host_api with dvdcss_set_host(), the CSS
+ * authentication commands (REPORT KEY / SEND KEY / READ DVD STRUCTURE) are
+ * built here as raw MMC CDBs and sent through the host's callback.
+ *****************************************************************************/
+#ifndef DVDCSS_HOST_H
+#define DVDCSS_HOST_H
+
+#include <stdarg.h>
+#include <stdint.h>
+
+int  dvdcss_host_active( void );
+void dvdcss_host_log( int i_level, const char *psz_prefix, const char *psz_format, va_list args );
+
+int host_ReadCopyright  ( int i_layer, int *pi_copyright );
+int host_ReadDiscKey    ( const int *pi_agid, uint8_t *p_key );
+int host_ReadTitleKey   ( const int *pi_agid, int i_pos, uint8_t *p_key );
+int host_ReportAgid     ( int *pi_agid );
+int host_ReportChallenge( const int *pi_agid, uint8_t *p_challenge );
+int host_ReportASF      ( int *pi_asf );
+int host_ReportKey1     ( const int *pi_agid, uint8_t *p_key );
+int host_InvalidateAgid ( int *pi_agid );
+int host_SendChallenge  ( const int *pi_agid, const uint8_t *p_challenge );
+int host_SendKey2       ( const int *pi_agid, const uint8_t *p_key );
+int host_ReportRPC      ( int *p_type, int *p_mask, int *p_scheme );
+
+#endif
