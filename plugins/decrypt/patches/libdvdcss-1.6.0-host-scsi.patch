diff -ruN a/libdvdcss-1.6.0/src/host.c b/libdvdcss-1.6.0/src/host.c
--- a/src/host.c	1970-01-01 00:00:00.000000000 +0000
+++ b/src/host.c	2026-11-11 03:50:06.145175185 +0000
@@ -0,0 +1,207 @@
+/*****************************************************************************
+ * host.c: SCSI pass-through supplied by the host application (DiskAndroid)
+ *****************************************************************************
+ * CDB layouts follow MMC REPORT KEY (A4h) / SEND KEY (A3h) / READ DVD
+ * STRUCTURE (ADh) for Key Class 00h, exactly as the raw-CDB backends in
+ * ioctl.c build them (Haiku / Solaris / OS/2): byte 7 = key class or
+ * structure format, bytes 8-9 = allocation / parameter list length,
+ * byte 10 = AGID << 6 | key format.
+ *
+ * Never sends SEND KEY key format 06h (RPC structure, sets the drive's
+ * region): libdvdcss does not need it and the host refuses it anyway.
+ *****************************************************************************/
+
+#include "config.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "dvdcss/dvdcss.h"
+#include "dc_host.h"
+#include "common.h"
+#include "css.h"
+#include "ioctl.h"
+#include "host.h"
+
+#define DVD_CHALLENGE_SIZE 10
+
+static dc_host_api g_host;
+static int g_host_set;
+
+LIBDVDCSS_EXPORT int dvdcss_set_host( const dc_host_api *p_host )
+{
+    if( p_host == NULL || p_host->version < 1 || p_host->scsi == NULL )
+    {
+        g_host_set = 0;
+        return DC_HOST_API_VERSION;
+    }
+    g_host = *p_host;
+    g_host_set = 1;
+    return DC_HOST_API_VERSION;
+}
+
+int dvdcss_host_active( void )
+{
+    return g_host_set;
+}
+
+void dvdcss_host_log( int i_level, const char *psz_prefix, const char *psz_format, va_list args )
+{
+    if( !g_host_set || g_host.log == NULL )
+        return;
+    char psz_msg[512];
+    int i = snprintf( psz_msg, sizeof( psz_msg ), "libdvdcss %s: ", psz_prefix );
+    if( i < 0 || i >= (int)sizeof( psz_msg ) )
+        i = 0;
+    vsnprintf( psz_msg + i, sizeof( psz_msg ) - i, psz_format, args );
+    g_host.log( g_host.opaque, i_level, psz_msg );
+}
+
+/* Send one 12-byte CDB. Returns 0 on GOOD status, -1 otherwise. */
+static int host_exec( uint8_t *p_cdb, int i_dir, uint8_t *p_buf, int i_len )
+{
+    uint8_t p_sense[32];
+    int i_sense = sizeof( p_sense );
+    if( !g_host_set )
+        return -1;
+    p_cdb[8] = ( i_len >> 8 ) & 0xff;
+    p_cdb[9] = i_len & 0xff;
+    int i_ret = g_host.scsi( g_host.opaque, p_cdb, 12, i_len ? i_dir : DC_DIR_NONE,
+                             p_buf, i_len, p_sense, &i_sense, 10000 );
+    return i_ret == 0 ? 0 : -1;
+}
+
+static void init_cdb( uint8_t *p_cdb, uint8_t i_op )
+{
+    memset( p_cdb, 0, 12 );
+    p_cdb[0] = i_op;
+}
+
+int host_ReadCopyright( int i_layer, int *pi_copyright )
+{
+    uint8_t p_cdb[12], p_buf[8];
+    init_cdb( p_cdb, GPCMD_READ_DVD_STRUCTURE );
+    memset( p_buf, 0, sizeof( p_buf ) );
+    p_cdb[6] = i_layer;
+    p_cdb[7] = DVD_STRUCT_COPYRIGHT;
+    int i_ret = host_exec( p_cdb, DC_DIR_IN, p_buf, sizeof( p_buf ) );
+    *pi_copyright = p_buf[4];
+    return i_ret;
+}
+
+int host_ReadDiscKey( const int *pi_agid, uint8_t *p_key )
+{
+    uint8_t p_cdb[12], p_buf[DVD_DISCKEY_SIZE + 4];
+    init_cdb( p_cdb, GPCMD_READ_DVD_STRUCTURE );
+    memset( p_buf, 0, sizeof( p_buf ) );
+    p_cdb[7] = DVD_STRUCT_DISCKEY;
+    p_cdb[10] = *pi_agid << 6;
+    int i_ret = host_exec( p_cdb, DC_DIR_IN, p_buf, sizeof( p_buf ) );
+    if( i_ret < 0 )
+        return i_ret;
+    memcpy( p_key, p_buf + 4, DVD_DISCKEY_SIZE );
+    return 0;
+}
+
+int host_ReadTitleKey( const int *pi_agid, int i_pos, uint8_t *p_key )
+{
+    uint8_t p_cdb[12], p_buf[12];
+    init_cdb( p_cdb, GPCMD_REPORT_KEY );
+    memset( p_buf, 0, sizeof( p_buf ) );
+    p_cdb[2] = ( i_pos >> 24 ) & 0xff;
+    p_cdb[3] = ( i_pos >> 16 ) & 0xff;
+    p_cdb[4] = ( i_pos >>  8 ) & 0xff;
+    p_cdb[5] = ( i_pos       ) & 0xff;
+    p_cdb[10] = DVD_REPORT_TITLE_KEY | ( *pi_agid << 6 );
+    int i_ret = host_exec( p_cdb, DC_DIR_IN, p_buf, sizeof( p_buf ) );
+    memcpy( p_key, p_buf + 5, DVD_KEY_SIZE );
+    return i_ret;
+}
+
+int host_ReportAgid( int *pi_agid )
+{
+    uint8_t p_cdb[12], p_buf[8];
+    init_cdb( p_cdb, GPCMD_REPORT_KEY );
+    memset( p_buf, 0, sizeof( p_buf ) );
+    p_cdb[10] = DVD_REPORT_AGID | ( *pi_agid << 6 );
+    int i_ret = host_exec( p_cdb, DC_DIR_IN, p_buf, sizeof( p_buf ) );
+    *pi_agid = p_buf[7] >> 6;
+    return i_ret;
+}
+
+int host_ReportChallenge( const int *pi_agid, uint8_t *p_challenge )
+{
+    uint8_t p_cdb[12], p_buf[16];
+    init_cdb( p_cdb, GPCMD_REPORT_KEY );
+    memset( p_buf, 0, sizeof( p_buf ) );
+    p_cdb[10] = DVD_REPORT_CHALLENGE | ( *pi_agid << 6 );
+    int i_ret = host_exec( p_cdb, DC_DIR_IN, p_buf, sizeof( p_buf ) );
+    memcpy( p_challenge, p_buf + 4, DVD_CHALLENGE_SIZE );
+    return i_ret;
+}
+
+int host_ReportASF( int *pi_asf )
+{
+    uint8_t p_cdb[12], p_buf[8];
+    init_cdb( p_cdb, GPCMD_REPORT_KEY );
+    memset( p_buf, 0, sizeof( p_buf ) );
+    p_cdb[10] = DVD_REPORT_ASF;
+    int i_ret = host_exec( p_cdb, DC_DIR_IN, p_buf, sizeof( p_buf ) );
+    *pi_asf = p_buf[7] & 1;
+    return i_ret;
+}
+
+int host_ReportKey1( const int *pi_agid, uint8_t *p_key )
+{
+    uint8_t p_cdb[12], p_buf[12];
+    init_cdb( p_cdb, GPCMD_REPORT_KEY );
+    memset( p_buf, 0, sizeof( p_buf ) );
+    p_cdb[10] = DVD_REPORT_KEY1 | ( *pi_agid << 6 );
+    int i_ret = host_exec( p_cdb, DC_DIR_IN, p_buf, sizeof( p_buf ) );
+    memcpy( p_key, p_buf + 4, DVD_KEY_SIZE );
+    return i_ret;
+}
+
+int host_InvalidateAgid( int *pi_agid )
+{
+    uint8_t p_cdb[12];
+    init_cdb( p_cdb, GPCMD_REPORT_KEY );
+    p_cdb[10] = DVDCSS_INVALIDATE_AGID | ( *pi_agid << 6 );
+    return host_exec( p_cdb, DC_DIR_NONE, NULL, 0 );
+}
+
+int host_SendChallenge( const int *pi_agid, const uint8_t *p_challenge )
+{
+    uint8_t p_cdb[12], p_buf[16];
+    init_cdb( p_cdb, GPCMD_SEND_KEY );
+    memset( p_buf, 0, sizeof( p_buf ) );
+    p_cdb[10] = DVD_SEND_CHALLENGE | ( *pi_agid << 6 );
+    p_buf[1] = 0xe;
+    memcpy( p_buf + 4, p_challenge, DVD_CHALLENGE_SIZE );
+    return host_exec( p_cdb, DC_DIR_OUT, p_buf, sizeof( p_buf ) );
+}
+
+int host_SendKey2( const int *pi_agid, const uint8_t *p_key )
+{
+    uint8_t p_cdb[12], p_buf[12];
+    init_cdb( p_cdb, GPCMD_SEND_KEY );
+    memset( p_buf, 0, sizeof( p_buf ) );
+    p_cdb[10] = DVD_SEND_KEY2 | ( *pi_agid << 6 );
+    p_buf[1] = 0xa;
+    memcpy( p_buf + 4, p_key, DVD_KEY_SIZE );
+    return host_exec( p_cdb, DC_DIR_OUT, p_buf, sizeof( p_buf ) );
+}
+
+int host_ReportRPC( int *p_type, int *p_mask, int *p_scheme )
+{
+    uint8_t p_cdb[12], p_buf[8];
+    init_cdb( p_cdb, GPCMD_REPORT_KEY );
+    memset( p_buf, 0, sizeof( p_buf ) );
+    p_cdb[10] = DVD_REPORT_RPC;
+    int i_ret = host_exec( p_cdb, DC_DIR_IN, p_buf, sizeof( p_buf ) );
+    *p_type = p_buf[4] >> 6;
+    *p_mask = p_buf[5];
+    *p_scheme = p_buf[6];
+    return i_ret;
+}
diff -ruN a/libdvdcss-1.6.0/src/host.h b/libdvdcss-1.6.0/src/host.h
